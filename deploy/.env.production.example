# Free / trial hosting — copy values into Vercel + Railway

# --- Neon Postgres (https://console.neon.tech) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Upstash Redis TCP (https://console.upstash.com) ---
# Use the Redis URL (not REST). BullMQ needs the Redis protocol.
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# --- Secrets (generate random 32+ chars) ---
BETTER_AUTH_SECRET=replace-with-long-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# --- Public URLs (set AFTER you know your domains) ---
# Vercel web URL, e.g. https://qaforge-ai.vercel.app
NEXT_PUBLIC_APP_URL=https://YOUR-APP.vercel.app
# Railway API public URL, e.g. https://qaforge-api-production.up.railway.app
NEXT_PUBLIC_API_URL=https://YOUR-API.up.railway.app
BETTER_AUTH_URL=https://YOUR-API.up.railway.app

# Optional
OPENROUTER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SENTRY_DSN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
