generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Better Auth compatible
model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  auditLogs     AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Organization {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  memberships      Membership[]
  projects         Project[]
  subscription     Subscription?
  githubConnection GitHubConnection?
  usageEvents      UsageEvent[]
  auditLogs        AuditLog[]
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String // OWNER ADMIN MEMBER VIEWER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Project {
  id              String                 @id @default(cuid())
  organizationId  String
  name            String
  description     String?                @db.Text
  appUrl          String?
  status          String                 @default("DRAFT") // DRAFT | ...
  /// NOT_STARTED | READY | RUNNING | COMPLETED | FAILED | STALE
  analysisStatus  String                 @default("NOT_STARTED")
  analysisStartedAt   DateTime?
  analysisCompletedAt DateTime?
  analysisError   String?                @db.Text
  staleRequirementCount Int              @default(0)
  loginUrl        String?
  framework       String                 @default("PLAYWRIGHT")
  language        String                 @default("TYPESCRIPT")
  environment     String                 @default("QA")
  encryptedConfig String?
  requirementText String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirements    RequirementDocument[]
  extractedRequirements Requirement[]
  featureGroups   FeatureGroup[]
  requirementQuestions RequirementQuestion[]
  requirementConflicts RequirementConflict[]
  requirementRelations RequirementRelation[]
  executions      Execution[]
  requirementSnapshots ProjectRequirementSnapshot[]
  clarificationRounds  ClarificationRound[]
  testCases            TestCase[]
  testResults          TestResult[]
  bugs                 Bug[]

  @@index([organizationId])
}

model RequirementDocument {
  id              String   @id @default(cuid())
  projectId       String
  storageKey      String
  mime            String
  filename        String
  fileSize        Int?
  sourceType      String   @default("UPLOAD") // UPLOAD | PASTE
  originalContent String?  @db.Text
  parsedText      String?  @db.Text
  /// Parsed structure: sections + tables (not requirements)
  documentStructure Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  extractedRequirements Requirement[]

  @@index([projectId])
}

/// Logical feature container (Business Area → Feature → Requirements). Does not merge/delete requirements.
model FeatureGroup {
  id               String   @id @default(cuid())
  projectId        String
  featureKey       String
  name             String
  businessArea     String?
  businessCapability String? @db.Text
  businessIntent   String?  @db.Text
  /// Highest requirement businessImpact (importance — not status)
  businessImpact   String?  // CRITICAL | HIGH | MEDIUM | LOW
  /// Risk from impact + unresolved gaps + conflicts (distinct from impact/status)
  featureRisk      String?  // CRITICAL | HIGH | MEDIUM | LOW
  featureRiskReason String? @db.Text
  reviewStatus     String?  // BLOCKED | NEEDS_CLARIFICATION | REVIEW_RECOMMENDED | READY_FOR_TEST_DESIGN
  analysis         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirements     Requirement[]
  questions        RequirementQuestion[]

  @@unique([projectId, featureKey])
  @@index([projectId])
  @@index([businessArea])
}

/// Structured requirements extracted from an original document (Piece 2+).
/// status: EXTRACTED | ...
/// reviewStatus: BLOCKED | NEEDS_CLARIFICATION | REVIEW_RECOMMENDED | READY_FOR_TEST_DESIGN
model Requirement {
  id                   String   @id @default(cuid())
  projectId            String
  requirementKey       String
  title                String
  description          String   @db.Text
  type                 String   // FUNCTIONAL | NON_FUNCTIONAL | BUSINESS_RULE (legacy primary)
  /// Dual typing — primaryType defaults from type when null
  primaryType          String?
  secondaryType        String?
  /// CRITICAL | HIGH | MEDIUM | LOW — business impact (independent of question count)
  businessImpact       String?
  /// EXPLICIT | USER_CONFIRMED | AI_DERIVED | AI_INFERRED
  intentSource         String?
  priority             String?
  status               String   @default("EXTRACTED")
  sourceDocumentId     String?
  sourcePage           Int?
  sourceSection        String?
  sourceText           String?  @db.Text
  acceptanceCriteria   Json?
  businessRules        Json?
  dependencies         Json?
  supportingInformation Json?
  possibleDuplicateOf  String?
  /// 0–100 internal confidence when shown for DUPLICATE / POSSIBLE_DUPLICATE
  duplicateSimilarity  Float?
  /// DUPLICATE | POSSIBLE_DUPLICATE | RELATED | NOT_DUPLICATE | null
  duplicateKind        String?
  /// Semantic reason for the duplicate/related classification
  duplicateReason      String?  @db.Text
  featureGroupId       String?
  /// BLOCKED | NEEDS_CLARIFICATION | REVIEW_RECOMMENDED | READY_FOR_TEST_DESIGN
  reviewStatus         String?
  /// READY | NEEDS_CLARIFICATION | BLOCKED
  businessReadiness    String?
  /// COMPLETE | PARTIAL | INCOMPLETE
  functionalCompleteness String?
  businessReview       Json?
  functionalReview     Json?
  readinessScore       Int?
  reviewedAt           DateTime?
  /// True when content changed after last analysis
  analysisStale        Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceDocument       RequirementDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  featureGroup         FeatureGroup? @relation(fields: [featureGroupId], references: [id], onDelete: SetNull)
  questions            RequirementQuestion[]
  conflictsAsA         RequirementConflict[] @relation("ConflictA")
  conflictsAsB         RequirementConflict[] @relation("ConflictB")
  relationsFrom        RequirementRelation[] @relation("RelationFrom")
  relationsTo          RequirementRelation[] @relation("RelationTo")

  @@unique([projectId, requirementKey])
  @@index([projectId])
  @@index([sourceDocumentId])
  @@index([reviewStatus])
  @@index([featureGroupId])
  @@index([businessImpact])
}

/// Clarification questions from Business + Functional review (not STLC ClarificationRound).
model RequirementQuestion {
  id             String   @id @default(cuid())
  projectId      String
  requirementId  String?
  featureGroupId String?
  /// REQUIREMENT | FEATURE
  scope          String   @default("REQUIREMENT")
  questionKey    String
  category       String
  priority       String   // CRITICAL | HIGH | MEDIUM | LOW
  question       String   @db.Text
  reason         String   @db.Text
  blocking       Boolean  @default(false)
  /// Normalized key for cross-requirement deduplication
  fingerprint    String?
  status         String   @default("OPEN") // OPEN | ANSWERED | DISMISSED
  answer         String?  @db.Text
  interpretation Json?
  answeredAt     DateTime?
  /// When this question is answered via / references another question
  linkedQuestionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement    Requirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  featureGroup   FeatureGroup? @relation(fields: [featureGroupId], references: [id], onDelete: SetNull)

  @@unique([projectId, questionKey])
  @@index([projectId])
  @@index([requirementId])
  @@index([featureGroupId])
  @@index([status])
  @@index([fingerprint])
}

model RequirementConflict {
  id              String   @id @default(cuid())
  projectId       String
  requirementAId  String
  requirementBId  String
  summary         String
  detail          String   @db.Text
  /// BUSINESS | FUNCTIONAL
  conflictType    String   @default("BUSINESS")
  status          String   @default("OPEN") // OPEN | RESOLVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementA    Requirement @relation("ConflictA", fields: [requirementAId], references: [id], onDelete: Cascade)
  requirementB    Requirement @relation("ConflictB", fields: [requirementBId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

/// Typed requirement relationships (does not replace extraction dependencies Json).
model RequirementRelation {
  id                String   @id @default(cuid())
  projectId         String
  fromRequirementId String
  toRequirementId   String
  /// DEPENDS_ON | AFFECTS | RELATED_TO | PRECEDES | CONFLICTS_WITH | DUPLICATE_OF | OVERLAPS
  relationType      String
  confidence        Float?
  source            String   @default("REVIEW") // EXTRACTION | REVIEW | USER
  detail            String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromRequirement   Requirement @relation("RelationFrom", fields: [fromRequirementId], references: [id], onDelete: Cascade)
  toRequirement     Requirement @relation("RelationTo", fields: [toRequirementId], references: [id], onDelete: Cascade)

  @@unique([fromRequirementId, toRequirementId, relationType])
  @@index([projectId])
  @@index([relationType])
}

model ProjectRequirementSnapshot {
  id           String   @id @default(cuid())
  projectId    String
  executionId  String?
  payload      Json
  clear        Boolean  @default(false)
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ClarificationRound {
  id          String   @id @default(cuid())
  projectId   String
  executionId String?
  round       Int
  questions   Json
  answers     Json?
  skipped     Boolean  @default(false)
  createdAt   DateTime @default(now())
  answeredAt  DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, round])
  @@index([executionId])
}

model Execution {
  id             String          @id @default(cuid())
  projectId      String
  status         String          @default("PENDING")
  phase          String          @default("INIT")
  runMode        String          @default("FULL") // FULL | PHASE1 | STLC
  scores         Json?
  errorSummary   String?         @db.Text
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRuns      AgentRun[]
  artifacts      Artifact[]
  browserSession BrowserSession?
  githubPushes   GitHubPush[]
  testCases      TestCase[]
  testResults    TestResult[]
  bugs           Bug[]

  @@index([projectId, createdAt])
  @@index([status])
}

model TestCase {
  id            String       @id @default(cuid())
  projectId     String
  executionId   String?
  externalId    String
  module        String?
  scenario      String
  preconditions String?      @db.Text
  steps         Json
  expected      String       @db.Text
  priority      String?
  severity      String?
  type          String?
  testData      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  execution     Execution?   @relation(fields: [executionId], references: [id], onDelete: SetNull)
  results       TestResult[]
  bugs          Bug[]

  @@index([projectId])
  @@index([executionId])
  @@index([projectId, externalId])
}

model TestResult {
  id           String    @id @default(cuid())
  projectId    String
  executionId  String?
  testCaseId   String
  status       String // PASSED FAILED SKIPPED ERROR
  message      String?   @db.Text
  durationMs   Int?
  evidenceKeys Json?
  createdAt    DateTime  @default(now())
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  execution    Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  testCase     TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  bugs         Bug[]

  @@index([projectId])
  @@index([executionId])
  @@index([testCaseId])
}

model Bug {
  id             String      @id @default(cuid())
  projectId      String
  executionId    String?
  testCaseId     String?
  testResultId   String?
  title          String
  severity       String      @default("medium")
  status         String      @default("OPEN")
  description    String      @db.Text
  stepsToReproduce String?   @db.Text
  evidenceKeys   Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  execution      Execution?  @relation(fields: [executionId], references: [id], onDelete: SetNull)
  testCase       TestCase?   @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  testResult     TestResult? @relation(fields: [testResultId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([executionId])
}

model AgentRun {
  id          String    @id @default(cuid())
  executionId String
  agentId     String
  status      String    @default("PENDING")
  inputRef    String?
  outputRef   String?
  tokensUsed  Int       @default(0)
  durationMs  Int?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model Artifact {
  id          String    @id @default(cuid())
  executionId String
  type        String
  storageKey  String
  mime        String
  size        Int       @default(0)
  checksum    String?
  createdAt   DateTime  @default(now())
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, type])
}

model BrowserSession {
  id          String    @id @default(cuid())
  executionId String    @unique
  status      String    @default("PENDING")
  containerId String?
  viewerUrl   String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

model GitHubConnection {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  encryptedAccessToken String
  githubUserId         String?
  githubLogin          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model GitHubPush {
  id           String    @id @default(cuid())
  executionId  String
  repoFullName String
  branch       String
  prUrl        String?
  commitSha    String?
  createdAt    DateTime  @default(now())
  execution    Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model Subscription {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  stripeCustomerId String?      @unique
  stripeSubId      String?      @unique
  plan             String       @default("FREE")
  status           String       @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model UsageEvent {
  id             String       @id @default(cuid())
  organizationId String
  type           String
  quantity       Int          @default(1)
  meta           Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
