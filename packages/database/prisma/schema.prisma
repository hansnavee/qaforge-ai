generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Better Auth compatible
model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  auditLogs     AuditLog[]
  localRunners  LocalRunner[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Organization {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  memberships      Membership[]
  projects         Project[]
  subscription     Subscription?
  githubConnection GitHubConnection?
  usageEvents      UsageEvent[]
  auditLogs        AuditLog[]
  caseFields       CaseField[]
  localRunners     LocalRunner[]
  /// AES blob { username, accessKey } for BrowserStack Cloud
  browserstackEncrypted String?
}

/// Paired laptop Playwright runner for Local AI execution (no Redis/DB on the PC).
model LocalRunner {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  name           String       @default("Local runner")
  tokenHash      String       @unique
  lastSeenAt     DateTime?
  userAgent      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([lastSeenAt])
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String // OWNER ADMIN LEAD MEMBER TESTER VIEWER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Project {
  id              String                 @id @default(cuid())
  organizationId  String
  name            String
  description     String?                @db.Text
  appUrl          String?
  status          String                 @default("DRAFT") // DRAFT | ...
  /// NOT_STARTED | READY | RUNNING | COMPLETED | FAILED | STALE
  analysisStatus  String                 @default("NOT_STARTED")
  analysisStartedAt   DateTime?
  analysisCompletedAt DateTime?
  analysisError   String?                @db.Text
  /// e.g. ANL-cuid — identifies a fresh analysis run
  analysisId      String?
  /// e.g. 2.3 — invalidates stale UI assumptions after engine upgrades
  analysisVersion String?
  /// e.g. semantic-requirement-review
  analysisEngine  String?
  /// Snapshot: relationships[], analyzedAt, counts (canonical review output)
  analysisMeta    Json?
  staleRequirementCount Int              @default(0)
  loginUrl        String?
  framework       String                 @default("PLAYWRIGHT")
  language        String                 @default("TYPESCRIPT")
  environment     String                 @default("QA")
  /// HEADLESS | HEADED — browser mode for execution
  browserMode     String                 @default("HEADLESS")
  /// SPRINT | KANBAN
  testStrategy    String                 @default("SPRINT")
  kanbanWipLimit  Int?
  healRequiresReview Boolean             @default(false)
  llmHealRequiresApproval Boolean        @default(true)
  allowExecuteQuarantined Boolean        @default(false)
  encryptedConfig String?
  requirementText String?                @db.Text
  /// Human gate after Step 2 review — required before STLC Test Planning
  requirementsApprovedAt DateTime?
  requirementsApprovedBy String?
  /// Latest human rejection of requirements pack (cleared on Approve)
  requirementsRejectedAt DateTime?
  requirementsRejectedBy String?
  requirementsRejectionReason String?    @db.Text
  /// Human gate after Stage 2 test strategy — required before Test Design
  testPlanApprovedAt DateTime?
  testPlanApprovedBy String?
  /// Human gate after Stage 3 test design — required before Environment
  testDesignApprovedAt DateTime?
  testDesignApprovedBy String?
  /// Human gate after Stage 4 environment — required before Test Data
  environmentApprovedAt DateTime?
  environmentApprovedBy String?
  /// Human gate after Stage 5 test data — required before Test Execution
  testDataApprovedAt DateTime?
  testDataApprovedBy String?
  /// Human gate after Stage 6 test execution — required before Defect Management
  testExecutionApprovedAt DateTime?
  testExecutionApprovedBy String?
  /// Human gate after Stage 7 defect management — required before Automation
  defectsApprovedAt DateTime?
  defectsApprovedBy String?
  /// Legacy regression gate (folded into Execution; kept for older rows)
  regressionApprovedAt DateTime?
  regressionApprovedBy String?
  /// Human gate after Stage 8 automation — required before Reporting
  automationApprovedAt DateTime?
  automationApprovedBy String?
  /// Human gate after Stage 9 report — required before Sign-off
  reportApprovedAt DateTime?
  reportApprovedBy String?
  /// Final Stage 10 QA sign-off
  qaSignedOffAt   DateTime?
  qaSignedOffBy   String?
  /// Mutable STLC phase documents for UI view/edit/accept
  stlcPhaseDocs   Json?
  /// STLC stage: REQUIREMENTS|PLANNING|DESIGN|ENVIRONMENT|DATA|EXECUTION|DEFECTS|AUTOMATION|REPORTING|SIGNOFF|DONE
  stlcStage       String                 @default("REQUIREMENTS")
  /// Highest STLC cycle number started for this project (Cycle 1 = full STLC)
  currentCycle    Int                    @default(1)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirements    RequirementDocument[]
  extractedRequirements Requirement[]
  featureGroups   FeatureGroup[]
  requirementQuestions RequirementQuestion[]
  requirementConflicts RequirementConflict[]
  requirementRelations RequirementRelation[]
  executions      Execution[]
  requirementSnapshots ProjectRequirementSnapshot[]
  clarificationRounds  ClarificationRound[]
  testCases            TestCase[]
  testResults          TestResult[]
  bugs                 Bug[]
  tcmsFolders          TcmsFolder[]
  caseFields           CaseField[]
  caseTemplates        CaseTemplate[]
  automatedScripts     AutomatedScript[]
  automationReports    AutomationReport[]
  automationHealLogs   AutomationHealLog[]
  aiPromptHistory      AiPromptHistory[]

  @@index([organizationId])
}

/// Per-project AI generate/update prompt history (shared by org members with project access).
model AiPromptHistory {
  id        String   @id @default(cuid())
  projectId String
  userId    String?
  prompt    String   @db.Text
  /// GENERATE | UPDATE | ENV_REFRESH
  source    String
  caseCount Int?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model RequirementDocument {
  id              String   @id @default(cuid())
  projectId       String
  storageKey      String
  mime            String
  filename        String
  fileSize        Int?
  sourceType      String   @default("UPLOAD") // UPLOAD | PASTE
  originalContent String?  @db.Text
  parsedText      String?  @db.Text
  /// Parsed structure: sections + tables (not requirements)
  documentStructure Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  extractedRequirements Requirement[]

  @@index([projectId])
}

/// Logical feature container (Business Area → Feature → Requirements). Does not merge/delete requirements.
model FeatureGroup {
  id               String   @id @default(cuid())
  projectId        String
  featureKey       String
  name             String
  businessArea     String?
  businessCapability String? @db.Text
  businessIntent   String?  @db.Text
  /// Highest requirement businessImpact (importance — not status)
  businessImpact   String?  // CRITICAL | HIGH | MEDIUM | LOW
  /// Risk from impact + unresolved gaps + conflicts (distinct from impact/status)
  featureRisk      String?  // CRITICAL | HIGH | MEDIUM | LOW
  featureRiskReason String? @db.Text
  reviewStatus     String?  // BLOCKED | NEEDS_CLARIFICATION | REVIEW_RECOMMENDED | READY_FOR_TEST_DESIGN
  analysis         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirements     Requirement[]
  questions        RequirementQuestion[]

  @@unique([projectId, featureKey])
  @@index([projectId])
  @@index([businessArea])
}

/// Structured requirements extracted from an original document (Piece 2+).
/// status: EXTRACTED | ...
/// reviewStatus: BLOCKED | NEEDS_CLARIFICATION | REVIEW_RECOMMENDED | READY_FOR_TEST_DESIGN
model Requirement {
  id                   String   @id @default(cuid())
  projectId            String
  requirementKey       String
  title                String
  description          String   @db.Text
  type                 String   // FUNCTIONAL | NON_FUNCTIONAL | BUSINESS_RULE (legacy primary)
  /// Dual typing — primaryType defaults from type when null
  primaryType          String?
  secondaryType        String?
  /// CRITICAL | HIGH | MEDIUM | LOW — business impact (independent of question count)
  businessImpact       String?
  /// EXPLICIT | USER_CONFIRMED | AI_DERIVED | AI_INFERRED
  intentSource         String?
  priority             String?
  status               String   @default("EXTRACTED")
  sourceDocumentId     String?
  sourcePage           Int?
  sourceSection        String?
  sourceText           String?  @db.Text
  acceptanceCriteria   Json?
  businessRules        Json?
  dependencies         Json?
  supportingInformation Json?
  possibleDuplicateOf  String?
  /// DEPRECATED as decision signal — kept nullable; API must not use as primary
  duplicateSimilarity  Float?
  /// DUPLICATE | POSSIBLE_DUPLICATE | RELATED | NOT_DUPLICATE | null
  duplicateKind        String?
  /// Semantic reason for the duplicate/related classification
  duplicateReason      String?  @db.Text
  /// Canonical RequirementRelationship[] from semantic engine (source of truth)
  relationships        Json?
  featureGroupId       String?
  /// BLOCKED | NEEDS_CLARIFICATION | REVIEW_RECOMMENDED | READY_FOR_TEST_DESIGN
  reviewStatus         String?
  /// READY | NEEDS_CLARIFICATION | BLOCKED
  businessReadiness    String?
  /// COMPLETE | PARTIAL | INCOMPLETE
  functionalCompleteness String?
  businessReview       Json?
  functionalReview     Json?
  readinessScore       Int?
  reviewedAt           DateTime?
  /// True when content changed after last analysis
  analysisStale        Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceDocument       RequirementDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  featureGroup         FeatureGroup? @relation(fields: [featureGroupId], references: [id], onDelete: SetNull)
  questions            RequirementQuestion[]
  conflictsAsA         RequirementConflict[] @relation("ConflictA")
  conflictsAsB         RequirementConflict[] @relation("ConflictB")
  relationsFrom        RequirementRelation[] @relation("RelationFrom")
  relationsTo          RequirementRelation[] @relation("RelationTo")

  @@unique([projectId, requirementKey])
  @@index([projectId])
  @@index([sourceDocumentId])
  @@index([reviewStatus])
  @@index([featureGroupId])
  @@index([businessImpact])
}

/// Clarification questions from Business + Functional review (not STLC ClarificationRound).
model RequirementQuestion {
  id             String   @id @default(cuid())
  projectId      String
  requirementId  String?
  featureGroupId String?
  /// REQUIREMENT | FEATURE
  scope          String   @default("REQUIREMENT")
  questionKey    String
  category       String
  priority       String   // CRITICAL | HIGH | MEDIUM | LOW
  question       String   @db.Text
  reason         String   @db.Text
  blocking       Boolean  @default(false)
  /// Normalized key for cross-requirement deduplication
  fingerprint    String?
  status         String   @default("OPEN") // OPEN | ANSWERED | DISMISSED
  answer         String?  @db.Text
  interpretation Json?
  answeredAt     DateTime?
  /// When this question is answered via / references another question
  linkedQuestionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement    Requirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  featureGroup   FeatureGroup? @relation(fields: [featureGroupId], references: [id], onDelete: SetNull)

  @@unique([projectId, questionKey])
  @@index([projectId])
  @@index([requirementId])
  @@index([featureGroupId])
  @@index([status])
  @@index([fingerprint])
}

model RequirementConflict {
  id              String   @id @default(cuid())
  projectId       String
  requirementAId  String
  requirementBId  String
  summary         String
  detail          String   @db.Text
  /// BUSINESS | FUNCTIONAL
  conflictType    String   @default("BUSINESS")
  status          String   @default("OPEN") // OPEN | RESOLVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementA    Requirement @relation("ConflictA", fields: [requirementAId], references: [id], onDelete: Cascade)
  requirementB    Requirement @relation("ConflictB", fields: [requirementBId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

/// Typed requirement relationships (does not replace extraction dependencies Json).
model RequirementRelation {
  id                String   @id @default(cuid())
  projectId         String
  fromRequirementId String
  toRequirementId   String
  /// DEPENDS_ON | AFFECTS | RELATED_TO | PRECEDES | CONFLICTS_WITH | DUPLICATE_OF | OVERLAPS
  relationType      String
  confidence        Float?
  source            String   @default("REVIEW") // EXTRACTION | REVIEW | USER
  detail            String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromRequirement   Requirement @relation("RelationFrom", fields: [fromRequirementId], references: [id], onDelete: Cascade)
  toRequirement     Requirement @relation("RelationTo", fields: [toRequirementId], references: [id], onDelete: Cascade)

  @@unique([fromRequirementId, toRequirementId, relationType])
  @@index([projectId])
  @@index([relationType])
}

model ProjectRequirementSnapshot {
  id           String   @id @default(cuid())
  projectId    String
  executionId  String?
  payload      Json
  clear        Boolean  @default(false)
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ClarificationRound {
  id          String   @id @default(cuid())
  projectId   String
  executionId String?
  round       Int
  questions   Json
  answers     Json?
  skipped     Boolean  @default(false)
  createdAt   DateTime @default(now())
  answeredAt  DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, round])
  @@index([executionId])
}

model Execution {
  id                String          @id @default(cuid())
  projectId         String
  status            String          @default("PENDING")
  phase             String          @default("INIT")
  runMode           String          @default("FULL") // FULL | PHASE1 | STLC
  /// STLC cycle index (1 = full planning→signoff; 2+ reuse design and re-exec)
  cycleNumber       Int             @default(1)
  parentExecutionId String?
  /// { testCaseIds: string[], runKind: SPRINT | REGRESSION | SYSTEM }
  selection         Json?
  scores            Json?
  errorSummary      String?         @db.Text
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentExecution   Execution?      @relation("ExecutionCycles", fields: [parentExecutionId], references: [id], onDelete: SetNull)
  childExecutions   Execution[]     @relation("ExecutionCycles")
  agentRuns         AgentRun[]
  artifacts         Artifact[]
  browserSession    BrowserSession?
  githubPushes      GitHubPush[]
  testCases         TestCase[]
  testResults       TestResult[]
  bugs              Bug[]
  automationReports AutomationReport[]

  @@index([projectId, createdAt])
  @@index([projectId, cycleNumber])
  @@index([status])
  @@index([parentExecutionId])
}

/// TCMS folder tree (separate from requirements FeatureGroup).
model TcmsFolder {
  id             String       @id @default(cuid())
  projectId      String
  parentId       String?
  name           String
  sortOrder      Int          @default(0)
  /// Optional link to a requirements FeatureGroup key for AI-designed cases.
  featureKey     String?
  /// Optional link to a requirement key when this is a synced subfolder.
  requirementKey String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent         TcmsFolder?  @relation("TcmsFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       TcmsFolder[] @relation("TcmsFolderTree")
  testCases      TestCase[]

  @@index([projectId, parentId])
  @@index([projectId, featureKey])
}

model TestCase {
  id            String       @id @default(cuid())
  projectId     String
  executionId   String?
  folderId      String?
  externalId    String
  module        String?
  scenario      String
  preconditions String?      @db.Text
  steps         Json
  expected      String       @db.Text
  priority      String?
  severity      String?
  type          String?
  /// Linked requirement key from Phase 1 (REQ-001, …)
  requirementKey String?
  /// Design technique: EQUIVALENCE | BOUNDARY | DECISION_TABLE | STATE_TRANSITION | NEGATIVE | ERROR_GUESSING | HAPPY_PATH
  designTechnique String?
  /// Feature group key from Requirements (FG-001, …)
  featureKey    String?
  /// GENERIC (no live URL) | UI_GROUNDED (explored against the app)
  designMode    String?
  /// HIGH | MEDIUM | LOW — execution order is always High then Medium then Low
  priorityLabel String?
  /// Human marks a case ready before AI may execute it
  readyForExecution Boolean @default(false)
  /// DRAFT | APPROVED | READY — Ready is the only status execution may run
  caseStatus    String       @default("DRAFT")
  testData      Json?
  customFields  Json?
  templateId    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  execution     Execution?   @relation(fields: [executionId], references: [id], onDelete: SetNull)
  folder        TcmsFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  template      CaseTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  results       TestResult[]
  bugs          Bug[]
  automatedScripts AutomatedScript[]

  @@index([projectId])
  @@index([executionId])
  @@index([projectId, folderId])
  @@index([projectId, externalId])
  @@index([projectId, requirementKey])
  @@index([projectId, featureKey])
  @@index([projectId, readyForExecution])
  @@index([projectId, caseStatus])
  @@index([templateId])
}

model CaseField {
  id             String        @id @default(cuid())
  organizationId String
  /// null = all projects in the org; set = that project only
  projectId      String?
  key            String
  label          String
  /// TEXT | TEXTAREA | DROPDOWN | CHECKBOX | NUMBER
  type           String        @default("TEXT")
  options        Json?
  required       Boolean       @default(false)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([projectId])
}

model CaseTemplate {
  id        String     @id @default(cuid())
  projectId String
  name      String
  isDefault Boolean    @default(false)
  fieldKeys Json
  defaults  Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases TestCase[]

  @@index([projectId])
}

model TestResult {
  id           String    @id @default(cuid())
  projectId    String
  executionId  String?
  testCaseId   String
  status       String // PASSED FAILED BLOCKED SKIPPED ERROR
  message      String?   @db.Text
  durationMs   Int?
  evidenceKeys Json?
  /// HUMAN | AI
  executedBy   String?   @default("HUMAN")
  createdAt    DateTime  @default(now())
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  execution    Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  testCase     TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  bugs         Bug[]

  @@index([projectId])
  @@index([executionId])
  @@index([testCaseId])
}

model Bug {
  id             String      @id @default(cuid())
  projectId      String
  executionId    String?
  testCaseId     String?
  testResultId   String?
  title          String
  severity       String      @default("medium")
  status         String      @default("OPEN")
  description    String      @db.Text
  stepsToReproduce String?   @db.Text
  evidenceKeys   Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  execution      Execution?  @relation(fields: [executionId], references: [id], onDelete: SetNull)
  testCase       TestCase?   @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  testResult     TestResult? @relation(fields: [testResultId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([executionId])
}

model AgentRun {
  id          String    @id @default(cuid())
  executionId String
  agentId     String
  status      String    @default("PENDING")
  inputRef    String?
  outputRef   String?
  tokensUsed  Int       @default(0)
  durationMs  Int?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model Artifact {
  id          String    @id @default(cuid())
  executionId String
  type        String
  storageKey  String
  mime        String
  size        Int       @default(0)
  checksum    String?
  createdAt   DateTime  @default(now())
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, type])
  @@index([storageKey])
}

model AutomatedScript {
  id              String    @id @default(cuid())
  projectId       String
  testCaseId      String
  path            String
  source          String    @db.Text
  language        String    @default("TYPESCRIPT")
  framework       String    @default("PLAYWRIGHT")
  lastRunId       String?
  lastStatus      String?
  /// STABLE | WATCH | FLAKY | QUARANTINED
  stabilityStatus String    @default("STABLE")
  consecutivePasses Int     @default(0)
  healCount       Int       @default(0)
  lastVerifiedAt  DateTime?
  scriptVersion   Int       @default(1)
  /// EXECUTOR | HEALER | MANUAL
  recordedBy      String?
  /// Structured ActionEntry[] used for 0-LLM replay
  actionLog       Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase        TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([projectId, testCaseId])
  @@index([projectId])
  @@index([stabilityStatus])
}

model AutomationHealLog {
  id               String   @id @default(cuid())
  projectId        String
  testCaseId       String
  scriptVersion    Int
  /// RULE | LLM
  healerKind       String   @default("RULE")
  /// PENDING_REVIEW | COMMITTED | REJECTED | QUARANTINED | VERIFIED
  status           String   @default("VERIFIED")
  patchDiff        String?  @db.Text
  /// ActionEntry[] proposed by healer — applied on human approve
  patchedLog       Json?
  verificationRuns Json?
  rationale        Json?
  committed        Boolean  @default(false)
  tokensUsed       Int      @default(0)
  createdAt        DateTime @default(now())
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, testCaseId])
  @@index([projectId, status])
  @@index([createdAt])
}

model AutomationReport {
  id          String    @id @default(cuid())
  projectId   String
  executionId String
  name        String
  status      String
  passed      Int       @default(0)
  failed      Int       @default(0)
  blocked     Int       @default(0)
  skipped     Int       @default(0)
  pending     Int       @default(0)
  htmlKey     String?
  zipKey      String?
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([executionId])
}

/// Durable bytes for artifacts when R2/local disk is ephemeral (Railway).
model ArtifactBlob {
  storageKey String   @id
  mime       String
  size       Int      @default(0)
  body       Bytes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BrowserSession {
  id          String    @id @default(cuid())
  executionId String    @unique
  status      String    @default("PENDING")
  containerId String?
  viewerUrl   String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

model GitHubConnection {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  encryptedAccessToken String
  githubUserId         String?
  githubLogin          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model GitHubPush {
  id           String    @id @default(cuid())
  executionId  String
  repoFullName String
  branch       String
  prUrl        String?
  commitSha    String?
  createdAt    DateTime  @default(now())
  execution    Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model Subscription {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  stripeCustomerId String?      @unique
  stripeSubId      String?      @unique
  plan             String       @default("FREE")
  status           String       @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model UsageEvent {
  id             String       @id @default(cuid())
  organizationId String
  type           String
  quantity       Int          @default(1)
  meta           Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
