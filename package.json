{
  "name": "qaforge-ai",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @qaforge/database generate",
    "db:migrate": "pnpm --filter @qaforge/database migrate:dev",
    "db:push": "pnpm --filter @qaforge/database db:push",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:infra": "docker compose up -d postgres redis",
    "local-runner": "pnpm --filter @qaforge/worker local-runner"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
